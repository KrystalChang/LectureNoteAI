generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id             String   @id @default(uuid())
  originalName   String
  storedFilename String
  filePath       String
  totalPages     Int?
  uploadedAt     DateTime @default(now())
}