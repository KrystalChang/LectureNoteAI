generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Auth.js (NextAuth v5) — Prisma adapter models
// ============================================================
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  // App-owned data
  documents Document[]
  folders   Folder[]
  usage     UsageCounter[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Per-user daily usage counter, guards the shared Anthropic API key bill.
// `date` is a YYYY-MM-DD string in a fixed timezone; one row per user per day.
model UsageCounter {
  id     String @id @default(uuid())
  userId String
  date   String
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Document {
  id             String   @id @default(uuid())
  originalName   String
  storedFilename String
  filePath       String
  totalPages     Int?
  uploadedAt     DateTime @default(now())

  // JSON snapshot of this document's PromptPreferences, seeded from the library
  // defaults at upload time and editable per document. Null = never customised
  // (fall back to current library defaults). Read/written via the typed Prisma
  // client in src/lib/prefs_store.ts — run `prisma db push` (regenerates the
  // client) on the Mac after changing this.
  promptPreferences String?

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pages PageContent[]
  qa    QAEntry[]
  note  Note[]

  @@index([folderId])
  @@index([userId])
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderTree")
  documents Document[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([userId])
}

model PageContent {
  id            String  @id @default(uuid())
  documentId    String
  pageNumber    Int
  extractedText String
  summary       String?
  // Hash of the prompt (system + user + model + image flag) that produced
  // `summary`. Lets us reuse the cached summary when the prompt is unchanged
  // instead of regenerating on every page view.
  summaryPromptHash String?
  // True when the page has little/no extractable text (image-dominant slide),
  // so the client should send a rendered page image for a vision summary.
  isImageBased  Boolean @default(false)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
}

model QAEntry {
  id           String   @id @default(uuid())
  documentId   String
  pageNumber   Int
  selectedText String
  question     String
  answer       String
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, pageNumber])
}

model Note {
  id         String   @id @default(uuid())
  documentId String
  pageNumber Int
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
}

// Single-row table (id = "default") holding the library-wide general prompt
// defaults that seed every new upload. Read/written via the typed Prisma
// client in src/lib/prefs_store.ts.
model LibrarySettings {
  id              String   @id @default("default")
  preferencesJson String
  updatedAt       DateTime @updatedAt
}
