generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id             String   @id @default(uuid())
  originalName   String
  storedFilename String
  filePath       String
  totalPages     Int?
  uploadedAt     DateTime @default(now())

  // JSON snapshot of this document's PromptPreferences, seeded from the library
  // defaults at upload time and editable per document. Null = never customised
  // (fall back to current library defaults). Read/written via the typed Prisma
  // client in src/lib/prefs_store.ts — run `prisma db push` (regenerates the
  // client) on the Mac after changing this.
  promptPreferences String?

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  pages PageContent[]
  qa    QAEntry[]
  note  Note[]

  @@index([folderId])
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderTree")
  documents Document[]

  @@index([parentId])
}

model PageContent {
  id            String  @id @default(uuid())
  documentId    String
  pageNumber    Int
  extractedText String
  summary       String?
  // Hash of the prompt (system + user + model + image flag) that produced
  // `summary`. Lets us reuse the cached summary when the prompt is unchanged
  // instead of regenerating on every page view.
  summaryPromptHash String?
  // True when the page has little/no extractable text (image-dominant slide),
  // so the client should send a rendered page image for a vision summary.
  isImageBased  Boolean @default(false)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
}

model QAEntry {
  id           String   @id @default(uuid())
  documentId   String
  pageNumber   Int
  selectedText String
  question     String
  answer       String
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, pageNumber])
}

model Note {
  id         String   @id @default(uuid())
  documentId String
  pageNumber Int
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
}

// Single-row table (id = "default") holding the library-wide general prompt
// defaults that seed every new upload. Read/written via the typed Prisma
// client in src/lib/prefs_store.ts.
model LibrarySettings {
  id              String   @id @default("default")
  preferencesJson String
  updatedAt       DateTime @updatedAt
}
