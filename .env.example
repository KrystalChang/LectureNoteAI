# ============================================================
# Database (Postgres for production / multi-user)
# ============================================================
# Pooled connection string used by the app at runtime.
# e.g. Neon: postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# Direct (NON-pooled) connection, used only by `prisma migrate`.
# On Neon/Supabase this is the URL without the "-pooler" host.
DIRECT_URL=

# ============================================================
# Auth.js (NextAuth v5) — Google sign-in
# ============================================================
# Generate with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed if the deployment can't infer its own URL (most hosts can).
# Set to your public origin, e.g. https://lecturenote.example.com
# AUTH_URL=

# ============================================================
# Anthropic Claude API (shared server-side key — serves users who haven't
# added their own key; usage is capped by FREE_DAILY_LIMIT below)
# ============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# BYOK key encryption
# ============================================================
# 32-byte key for AES-256-GCM encryption of user-supplied API keys (BYOK).
# Generate with:  openssl rand -base64 32
# Rotating this invalidates saved user keys (users must re-enter theirs).
APP_ENCRYPTION_KEY=

# ============================================================
# Stripe (PRO subscription)
# ============================================================
# Dashboard → Developers → API keys (use the test key in development)
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint for POST /api/billing/webhook
# (events: checkout.session.completed, customer.subscription.created/updated/
# deleted, invoice.paid, invoice.payment_failed). Local dev:
#   stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# The recurring Price id of the PRO plan (Dashboard → Products)
STRIPE_PRICE_ID=

# ============================================================
# Model catalog sync (POST /api/models/sync)
# ============================================================
# Bearer secret for the sync endpoint; point a scheduler (e.g. Vercel Cron)
# at it to refresh the catalog daily. Generate with: openssl rand -hex 24
MODEL_SYNC_SECRET=

# ============================================================
# Hidden fair-use guardrails (optional overrides; sane defaults in code)
# ============================================================
# AI_MAX_INPUT_CHARS=60000
# PRO_MAX_REQUESTS_PER_MINUTE=20
# PRO_MAX_REQUESTS_PER_DAY=1000
# PRO_MAX_CONCURRENCY=4
# Daily FREE limits (20 summaries / 10 QA) are fixed in src/lib/quota/quota.ts.

# ============================================================
# Cloudflare R2 — PDF object storage (see docs/SETUP_R2.md)
# ============================================================
# Cloudflare dashboard → R2 → overview 右側的 Account ID
R2_ACCOUNT_ID=
# R2 → Manage R2 API Tokens → Create API Token (Object Read & Write, 限定 bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name, e.g. lecturenote-pdfs
R2_BUCKET=
